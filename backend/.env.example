NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
APP_PUBLIC_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PROVIDER=local
DATABASE_URL=
TICHA_DATA_FILE=.data/ticha-db.json
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=30

# AI provider mode:
# mock = deterministic local responses
# openai = call OpenAI Responses API
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ticha-uploads

# Future provider values can be added without changing route contracts.
STORAGE_PROVIDER=local
TTS_PROVIDER=mock
VISION_PROVIDER=mock
